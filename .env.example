# Copy to .env and fill in what you use. Never commit .env.

# First run: open the web UI and create the admin account. The one-time setup code it asks for is printed in the
# container log (docker compose logs drollery). Set your own instead if you prefer:
DROLLERY_SETUP_CODE=

# Set to 1 when the site is served over HTTPS (cookies are then marked Secure). Plain http on a LAN needs nothing.
DROLLERY_COOKIE_SECURE=

# Address used in share links when you share beyond your LAN, e.g. https://memes.example.org (can also be set in Settings > Shares)
DROLLERY_PUBLIC_URL=

# Host port the web UI is published on
DROLLERY_PORT=8080

# Which image `docker compose up -d` pulls. Empty = the newest ready-made image. Pin a release with e.g.
# ghcr.io/scriptknight-de/drollery:0.12.4 (the same image is also in forgejo.scriptknight.de/scriptknight/drollery).
# `docker compose up -d --build` ignores it and builds from this folder.
DROLLERY_IMAGE=

# AI models are now configured in the web UI: Settings > AI models. API keys for them are entered there.

# Local Whisper speech-to-text as a second container (off by default). Set to "whisper" to enable.
# Then add the model in Settings > AI models with the "Whisper server" preset and assign it to Transcription.
COMPOSE_PROFILES=
# Which Whisper model to download: Systran/faster-whisper-tiny | -base | -small | -medium | -large-v3
WHISPER_MODEL=Systran/faster-whisper-small
# Resource caps for the Whisper container
WHISPER_CPUS=4
WHISPER_MEM_LIMIT=3g
