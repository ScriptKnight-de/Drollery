# Copy to .env and fill in what you use. Never commit .env.

# Protects the web UI and the HTTP API (browser extension / Android app use it as a Bearer token).
# Leave empty ONLY on a trusted private network. Generate one with: openssl rand -hex 24
DROLLERY_TOKEN=

# Host port the web UI is published on
DROLLERY_PORT=8080

# API keys for AI providers; the variable names are referenced by api_key_env in data/config.toml
TRANSCRIBE_API_KEY=
DESCRIBE_API_KEY=
