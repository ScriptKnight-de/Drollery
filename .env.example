# Copy to .env and fill in what you use. Never commit .env.

# First run: open the web UI and create the admin account. The one-time setup code it asks for is printed in the
# container log (docker compose logs drollery). Set your own instead if you prefer:
DROLLERY_SETUP_CODE=

# Set to 1 when the site is served over HTTPS (cookies are then marked Secure). Plain http on a LAN needs nothing.
DROLLERY_COOKIE_SECURE=

# Address used in share links when you share beyond your LAN, e.g. https://memes.example.org (can also be set in Settings > Shares)
DROLLERY_PUBLIC_URL=

# Host port the web UI is published on
DROLLERY_PORT=8080

# AI models are now configured in the web UI: Settings > AI models. API keys for them are entered there.
